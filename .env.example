# ==========================================================
# EduHelp — Environment Configuration Template
# ==========================================================

# Backend API Configuration
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/eduhelp
JWT_SECRET=<YOUR_SECURE_RANDOM_JWT_SECRET_KEY>
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:5000/api

# Mobile Configuration (Flutter)
# Target Android Emulator host mapping (10.0.2.2) or local LAN IP
MOBILE_API_BASE_URL=http://10.0.2.2:5000/api
